---
import { render } from "astro:content";
import { PageHeader, Prose } from "@yamat47/pylon";
import Base from "../../layouts/Base.astro";
import { formatDay } from "../../lib/date";
import { excerpt } from "../../lib/excerpt";
import { getPosts, ogCardPath, type Post, postPath } from "../../lib/posts";
import { hasTweet } from "../../lib/tweets";

// A rest parameter, because the id of a post moved from Hatena Blog has slashes in it
// (2026/01/01/130022).
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

// How much of a post's start a search result or a shared link shows before cutting it itself.
const DESCRIPTION_LENGTH = 120;

const { post } = Astro.props;
const { Content } = await render(post);
const html = post.rendered?.html ?? "";
const hasTweets = hasTweet(html);
const day = formatDay(post.data.publishedAt);
---

<Base
  title={post.data.title}
  path={postPath(post)}
  description={excerpt(html, DESCRIPTION_LENGTH)}
  type="article"
  ogCardPath={ogCardPath(post)}
>
  {
    // Asks X not to use the visit for tailoring what the reader is shown there.
    hasTweets && <meta slot="head" name="twitter:dnt" content="on" />
  }
  {
    // The data-pagefind attributes are for the search index, which the build makes from the built
    // pages. The article is what a post is found by: a page without this mark is never a result.
    // The date is given to the index here, to be shown with a result. The one the header shows
    // is not searched: the index leaves every `time` out (the build script in package.json).
    // TODO: mark the header's date itself once pylon's `PageHeader` takes attributes for it, and
    // drop the flag from the build script.
  }
  <article data-pagefind-body data-pagefind-meta={`date:${day}`}>
    <PageHeader title={post.data.title} date={day} />
    <Prose>
      <Content />
    </Prose>
  </article>
  {
    // X's script turns each tweet's quote into the tweet as X shows it. Only a post that has a
    // tweet needs it, so only such a post loads it. Without it, or for a tweet that has been
    // deleted, the quote stays: the text, the author and a link.
    // The page is dark for a reader whose system is, and X's script draws a light tweet unless
    // it finds this meta when it runs, so the line before it adds one for such a reader.
    hasTweets && (
      <Fragment>
        <script is:inline>
          matchMedia("(prefers-color-scheme: dark)").matches && document.head.insertAdjacentHTML("beforeend", '<meta name="twitter:widgets:theme" content="dark">');
        </script>
        <script is:inline async src="https://platform.twitter.com/widgets.js" charset="utf-8" />
      </Fragment>
    )
  }
</Base>
