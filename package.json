{
  "name": "blog",
  "private": true,
  "description": "Source of blog.yamat47.me: Markdown posts built with Astro",
  "homepage": "https://blog.yamat47.me/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamat47/blog.git"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview --host",
    "typecheck": "astro check",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build"
  },
  "dependencies": {
    "astro": "^7.4.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.7",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@11.8.0"
}
