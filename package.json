{
  "name": "blog",
  "private": true,
  "description": "Source of blog.yamat47.me: Markdown posts built with Astro",
  "homepage": "https://blog.yamat47.me/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamat47/blog.git"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build --force && pagefind --site dist",
    "preview": "astro preview --host",
    "typecheck": "astro check",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.9",
    "@astrojs/react": "^7.1.9",
    "@yamat47/pylon": "^0.3.0",
    "astro": "^7.4.11",
    "pagefind": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@11.8.0"
}
